# Gullak AI Environment Configuration

# Application
APP_NAME="Gullak AI"
APP_ENV="development" # development | production | test
DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY="gullak-ai-fintech-hackathon-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite for zero-friction local development, PostgreSQL+pgvector in production
DATABASE_URL="sqlite+aiosqlite:///./gullak.db"
# DATABASE_URL="postgresql+asyncpg://gullak_admin:gullak_secure_password@localhost:5432/gullak_ai"

# Event Bus & Cache
EVENT_BUS_MODE="local" # local | kafka
REDIS_URL="redis://localhost:6379/0"
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# Sarvam AI Voice Infrastructure
SARVAM_ENABLED=true
SARVAM_API_KEY="" # Enter your Sarvam AI API key; mock fallback active if empty
SARVAM_BASE_URL="https://api.sarvam.ai"

# LLM Providers
LLM_PROVIDER="demo" # demo | sarvam | gemini | claude
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Fintech & Partner Integration Providers (demo | live)
PAYMENT_PROVIDER="demo"
SOUNDBOX_PROVIDER="demo"
WHATSAPP_PROVIDER="demo"
DISTRIBUTOR_PROVIDER="demo"
LENDING_PROVIDER="demo"

# DPDPA Consent & Governance
CONSENT_ENFORCEMENT=true
AUDIT_HASH_ALGORITHM="SHA-256"
MAX_AUTO_APPROVAL_AMOUNT=5000 # INR
